# Dependencies of BigMap, at the versions of the article's experiments (bigmap_experiments,
# tag bigmap-experiments-v2). From the workspace root:
#   vcs import src < src/BigMap/bigmap.repos
repositories:
  EasyNavigation:
    type: git
    url: https://github.com/EasyNavigation/EasyNavigation.git
    version: rolling
  yaets:
    type: git
    url: https://github.com/fmrico/yaets.git
    version: rolling
  # easynav_plugins: tag bigmap-experiments-v2 (the article's) without easynav_bigmap_maps_manager,
  # which is BigMap's. Fork until merged in EasyNavigation/easynav_plugins (#182, #183).
  easynav_plugins:
    type: git
    url: https://github.com/jmguerreroh/easynav_plugins.git
    version: bigmap
  # NavMap: rolling + #45 (buildings, large NavMaps of a place: navmap_gis_tool --navmap-out and
  # --navmap-keep), #46 (simplify bounds that change from place to place), #47 (keep_vertices,
  # cut_along_lines, refine), geometry patches and chunked RViz meshes. Branch bigmap: fractal-ws,
  # the article's (fdee528), plus --navmap-keep. Fork until merged in EasyNavigation/NavMap.
  NavMap:
    type: git
    url: https://github.com/jmguerreroh/NavMap.git
    version: bigmap
  # easynav_playground_geo (+ the Summit XL). Fork until the playground_geo PR is merged in
  # EasyNavigation/easynav_playgrounds.
  easynav_playgrounds:
    type: git
    url: https://github.com/jmguerreroh/easynav_playgrounds.git
    version: playground_geo
